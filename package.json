{
  "name": "reposition",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "ml:install": "python3 -m pip install -r ml/requirements.txt",
    "ml:train": "python3 ml/train_all.py",
    "ml:train:open": "python3 ml/train_all.py --from-open-data",
    "ml:infer": "python3 ml/infer.py",
    "data:download": "python3 ml/ingest/download.py",
    "data:build": "python3 ml/ingest/build_training.py",
    "data:ingest": "python3 ml/ingest/download.py && python3 ml/ingest/build_training.py",
    "data:listings": "python3 ml/ingest/listings.py --max 200",
    "metrics:detection": "python3 ml/metrics/evaluate_detection.py",
    "metrics": "python3 ml/ingest/listings.py --max 200 && python3 ml/metrics/evaluate_detection.py",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.3",
    "bullmq": "^6.0.5",
    "ioredis": "^6.0.0",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
