# Redis for BullMQ (required for /api/jobs + npm run worker)
REDIS_URL=redis://127.0.0.1:6379

# Supabase (after OAuth via Cursor Tools & MCP → supabase)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force Python XGBoost/LSTM/Transformer for scoring
# REPOSITION_USE_PYTHON_ML=1

# Worker concurrency
# WORKER_CONCURRENCY=2
